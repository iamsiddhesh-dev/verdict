# Copy to .env and fill in. Every service below has a free tier that needs no card.
# Only the REQUIRED lines are needed to run; the rest add capacity or options.

# --- Database ------------------------------------------------------------------
# Supabase: Project -> Connect -> "Session pooler" connection string (IPv4).
# Leave empty for local development: the app then runs on PGlite in .data/.
DATABASE_URL=

# --- Sessions (REQUIRED in production) -----------------------------------------
# Signs the anonymous session cookie. 64 random hex characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out of their runs.
SESSION_SECRET=

# --- Models --------------------------------------------------------------------
# Each accepts a comma-separated list (GROQ_API_KEYS=a,b) for more capacity.
# At least Groq and Gemini are needed for every stage to have a model.

# Groq (console.groq.com). REQUIRED. Reads jobs, scores fit, parses resumes.
GROQ_API_KEY=
# Google AI Studio (aistudio.google.com). REQUIRED. Writes answers, outreach and
# tailored resumes, and reads screenshots.
GEMINI_API_KEY=
# Mistral (console.mistral.ai, free Experiment plan). Optional. Second choice for writing.
MISTRAL_API_KEY=
# Cerebras (cloud.cerebras.ai). Optional. Last fallback; its free key has returned 402.
CEREBRAS_API_KEY=

# --- Optional tuning ------------------------------------------------------------
# Runs processed at once by the in-process worker. Default 3.
WORKER_CONCURRENCY=
# Override a model's assumed free-tier limits without a deploy, e.g.
# {"google/gemini-flash-latest":{"rpd":50}}
LLM_LIMITS_JSON=
# Path to a tectonic binary if it is not on PATH. The Docker image has one.
TECTONIC_PATH=
# Port to listen on. Hugging Face Spaces expects 7860; most hosts set this themselves.
PORT=
